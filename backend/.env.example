# Copy to backend/.env and fill in. Never commit backend/.env.

PORT=5001
DB_PATH=./database.sqlite
NODE_ENV=development

# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start with a missing, short or published value.
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_STRING
JWT_EXPIRES_IN=8h

# Front-end addresses allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set when the API runs behind a reverse proxy so client addresses are read correctly.
# Examples: 1 (one proxy hop), true, or a subnet such as loopback. Leave empty if not behind a proxy.
TRUST_PROXY=

# Campus network address ranges (CIDR, comma separated). Used to tell on-campus check-ins
# from off-campus ones. Example: 10.20.0.0/16,192.168.50.0/24. Empty = no campus check.
CAMPUS_IP_RANGES=

# What to do with a check-in from outside the campus ranges: "flag" (accept and flag for
# admin review) or "block" (refuse).
CHECKIN_OFF_CAMPUS=flag
