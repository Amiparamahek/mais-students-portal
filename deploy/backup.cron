# Daily database backup at 02:30. Install with: crontab -e (as the portal user), paste this line.
# Keeps the newest 14 copies in backend/backups/. Copy that folder off the server too.
30 2 * * * cd /opt/mais-students-portal/backend && /usr/bin/node scripts/backup.js >> /var/log/mais-backup.log 2>&1
